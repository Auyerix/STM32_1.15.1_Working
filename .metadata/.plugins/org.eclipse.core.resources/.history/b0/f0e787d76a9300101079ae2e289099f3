// suscribirse a un topic
bool MQTT_Subscribe(const char* topic)
{
    char cmd[160];
    char topic_crlf[MQTT_TOPIC_SIZE + 4];
    int tlen = (int)strlen(topic);

    // Paso 1: indicar el topic length y esperar prompt '>' (o OK)
    snprintf(cmd, sizeof(cmd), "AT+CMQTTSUBTOPIC=0,%d,1\r\n", tlen);

    // Preferimos esperar el prompt '>' (forma recomendada por tu manual)
    if (SIMTransmit(cmd, ">", 2000)) {
        // recibimos '>' -> enviar topic y esperar OK
        snprintf(topic_crlf, sizeof(topic_crlf), "%s\r\n", topic);
        if (!SIMTransmit(topic_crlf, "OK", 4000)) {
            // si falla al enviar el topic -> error
            return false;
        }
    } else {
        // No vino '>' dentro del timeout. Algunos firmwares responden "OK" y luego esperan topic.
        // Intentamos aceptar OK y luego enviar topic.
        if (SIMTransmit(cmd, "OK", 2000)) {
            // enviar topic y esperar OK (fall back)
            snprintf(topic_crlf, sizeof(topic_crlf), "%s\r\n", topic);
            if (!SIMTransmit(topic_crlf, "OK", 4000)) {
                return false;
            }
        } else {
            // Ni '>' ni 'OK' -> no se pudo definir topic
            return false;
        }
    }

    // Paso 2: ejecutar la suscripción
    if (!SIMTransmit("AT+CMQTTSUB=0\r\n", "OK", 4000)) {
        return false;
    }

    // Finalmente esperar la confirmación +CMQTTSUB: 0,0 (o al menos +CMQTTSUB:)
    // SIMTransmit dejó la respuesta en el buffer global (ej. rx_buffer)
    if (strstr(rx_buffer, "+CMQTTSUB:") != NULL) {
        return true;
    }

    // Si no aparece +CMQTTSUB, consideramos fallo (podés relajar esta condición si tu FW varía)
    return false;
}
