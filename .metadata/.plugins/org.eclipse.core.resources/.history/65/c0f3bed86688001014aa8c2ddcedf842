#include <debounce.h>
#include "gpio.h"


bool Pulsador_Presionado(void) {
    static uint32_t lastDebounceTime = 0;
    static bool lastReading = true;  // con pull-up, botón no presionado = HIGH
    static bool buttonPressed = false;

    bool reading = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);
    uint32_t now = HAL_GetTick();

    if (reading != lastReading) {
        lastDebounceTime = now;  // reinicia el debounce
    }

    if ((now - lastDebounceTime) > 50) { // debounce de 50 ms
        if (lastReading == GPIO_PIN_SET && reading == GPIO_PIN_RESET) {
            buttonPressed = true;
        }
    }

    lastReading = reading;

    if (buttonPressed) {
        buttonPressed = false; // limpia el evento
        return true;           // devuelve un solo pulso por click
    }

    return false;
}
