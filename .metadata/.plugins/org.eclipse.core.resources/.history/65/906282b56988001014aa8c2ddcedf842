#include "debounce.h"
#include "gpio.h"
#include "stm32f4xx_hal.h" // o el header del HAL que uses


bool Pulsador_Presionado(void) {
    static uint32_t lastDebounceTime = 0;
    static GPIO_PinState lastReading = GPIO_PIN_SET;  // botón no presionado = HIGH
    static bool buttonPressed = false;

    GPIO_PinState reading = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);
    uint32_t now = HAL_GetTick();

    if (reading != lastReading) {
        lastDebounceTime = now;
    }

    if ((now - lastDebounceTime) > 50) {
        if (lastReading == GPIO_PIN_SET && reading == GPIO_PIN_RESET) {
            buttonPressed = true;
        }
    }

    lastReading = reading;

    if (buttonPressed) {
        buttonPressed = false;
        return true;
    }

    return false;
}
