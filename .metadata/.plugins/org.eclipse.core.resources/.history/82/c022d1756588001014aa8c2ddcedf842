#include <debounce.h>
#include "gpio.h"


bool Pulsador_Presionado(void) {
    static bool lastState = true;  // asumimos pull-up: no presionado = HIGH
    static bool buttonPressed = false;
    static uint32_t lastTime = 0;

    bool currentState = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);
    uint32_t now = HAL_GetTick();

    // Simple debounce 50 ms
    if (currentState != lastState) {
        lastTime = now;
    }

    if ((now - lastTime) > 50) {
        if (lastState == GPIO_PIN_SET && currentState == GPIO_PIN_RESET) {
            buttonPressed = true;  // flanco descendente detectado
        }
        lastState = currentState;
    }

    if (buttonPressed) {
        buttonPressed = false; // limpiar evento
        return true;           // devuelve un pulso
    }

    return false;
}
