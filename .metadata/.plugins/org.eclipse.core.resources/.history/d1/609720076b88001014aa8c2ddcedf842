#include "debounce.h"
#include "gpio.h"
#include "stm32f4xx_hal.h" // o el header del HAL que uses


bool Pulsador_Presionado(void) {
    static bool lastState = GPIO_PIN_SET;  // con pull-up, botón no presionado = HIGH
    static bool eventTriggered = false;
    static uint32_t lastChangeTime = 0;

    bool currentState = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);
    uint32_t now = HAL_GetTick();

    // Detecta cambio de estado
    if (currentState != lastState) {
        lastChangeTime = now;  // reinicia debounce
    }

    // Si pasó el debounce
    if ((now - lastChangeTime) > 50) {  // 50 ms
        // Detecta flanco descendente (presión del botón)
        if (lastState == GPIO_PIN_SET && currentState == GPIO_PIN_RESET) {
            eventTriggered = true;
        }
    }

    lastState = currentState;

    if (eventTriggered) {
        eventTriggered = false;  // limpia evento
        return true;             // devuelve solo un pulso
    }

    return false;
}
